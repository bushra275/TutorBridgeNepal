@{
    var name = ViewData["SidebarName"] as string ?? "";
    var initials = ViewData["SidebarInitials"] as string ?? "?";
    var photoUrl = ViewData["SidebarPhotoUrl"] as string;
    var meta = ViewData["SidebarMeta"] as string ?? "Tutor";
    var activeNav = ViewData["ActiveNav"] as string ?? "";
    var pendingCount = ViewData["PendingRequestCount"] as int? ?? 0;
    var unreadCount = ViewData["UnreadMessageCount"] as int? ?? 0;
}
<aside class="dash-sidebar">
    <div class="dash-user">
        @if (!string.IsNullOrEmpty(photoUrl))
        {
            <div class="avatar" style="padding:0; overflow:hidden;"><img src="@photoUrl" alt="@name" style="width:100%; height:100%; object-fit:cover; border-radius:50%;" /></div>
        }
        else
        {
            <div class="avatar">@initials</div>
        }
        <div>
            <div class="name">@name</div>
            <div class="meta">@meta</div>
            <span class="role-chip">Tutor</span>
        </div>
    </div>

    <ul class="dash-nav">
        <li><a id="navDashboard" asp-controller="Tutor" asp-action="Dashboard" class="@(activeNav == "dashboard" ? "active" : "")"><span class="nav-icon">🏠</span> Dashboard</a></li>
        <li><a asp-controller="Tutor" asp-action="Schedule" class="@(activeNav == "schedule" ? "active" : "")"><span class="nav-icon">🗓️</span> My Schedule</a></li>
        <li>
            <a id="navSessionRequests" asp-controller="Tutor" asp-action="SessionRequests" class="@(activeNav == "sessionrequests" ? "active" : "")">
                <span class="nav-icon">📥</span> Session Requests
                @if (pendingCount > 0)
                {
                    <span class="badge-count">@pendingCount</span>
                }
            </a>
        </li>
        <li>
            <a asp-controller="Tutor" asp-action="Messages" class="@(activeNav == "messages" ? "active" : "")">
                <span class="nav-icon">💬</span> Messages
                @if (unreadCount > 0)
                {
                    <span class="badge-count">@unreadCount</span>
                }
            </a>
        </li>
        <li><a asp-controller="Tutor" asp-action="Reviews" class="@(activeNav == "reviews" ? "active" : "")"><span class="nav-icon">⭐</span> Reviews</a></li>
        <li><a asp-controller="Tutor" asp-action="Profile" class="@(activeNav == "myprofile" ? "active" : "")"><span class="nav-icon">👤</span> My Profile</a></li>
    </ul>

    <ul class="dash-nav-secondary">
        <li><a asp-controller="Tutor" asp-action="SettingsAccount" class="@(activeNav == "settings" ? "active" : "")"><span class="nav-icon">⚙️</span> Settings</a></li>
        <li><a asp-controller="Tutor" asp-action="HelpSupport" class="@(activeNav == "help" ? "active" : "")"><span class="nav-icon">❓</span> Help &amp; Support</a></li>
        <li><a asp-controller="Account" asp-action="Logout"><span class="nav-icon">↩️</span> Log out</a></li>
    </ul>
</aside>