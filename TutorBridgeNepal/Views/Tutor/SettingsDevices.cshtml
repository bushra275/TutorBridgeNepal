@model TutorBridgeNepal.ViewModels.TutorSettingsPageViewModel
@{
    ViewData["Title"] = "Linked devices";
    ViewData["SettingsActiveSection"] = "devices";
    Layout = "_SettingsLayout";
}

<div class="panel">
    <div class="panel-head">
        <h2>Linked devices</h2>
    </div>

    @if (!Model.Devices.Any())
    {
        <p class="empty-state">You're not signed in anywhere we can detect right now.</p>
    }
    else
    {
        <div class="device-list">
            @foreach (var device in Model.Devices)
            {
                <div class="device-row">
                    <div class="device-info">
                        <div class="device-name">
                            @device.DeviceLabel
                            @if (device.IsCurrentDevice)
                            {
                                <span class="msc-badge" style="background:var(--soft); color:var(--muted); margin-left:.5rem;">This device</span>
                            }
                        </div>
                        <div class="device-meta">
                            @(string.IsNullOrWhiteSpace(device.IpAddress) ? "Unknown location" : device.IpAddress)
                            · Last active @device.LastActiveAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")
                            · Signed in @device.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                        </div>
                    </div>
                    <form asp-controller="Tutor" asp-action="RevokeDevice" method="post" class="device-revoke-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@device.Id" />
                        <button type="submit" class="tb-btn-danger-outline">
                            @(device.IsCurrentDevice ? "Sign out" : "Sign out device")
                        </button>
                    </form>
                </div>
            }
        </div>
    }

    <div class="settings-toggle-row" style="border-top:1px solid var(--line); padding-top:1.1rem; margin-top:.3rem;">
        <div>
            <div class="settings-toggle-title">Everything, everywhere</div>
            <div class="settings-toggle-sub">Sign out of TutorBridge Nepal on every device you're logged into</div>
        </div>
        <form asp-controller="Tutor" asp-action="SignOutAllDevices" method="post" id="signOutAllFormDevices">
            @Html.AntiForgeryToken()
            <button type="submit" class="tb-btn-danger-outline">Sign out all</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.device-revoke-form').forEach(function(form) {
            form.addEventListener('submit', function(e) {
                if (!confirm("Sign this device out of TutorBridge Nepal?")) {
                    e.preventDefault();
                }
            });
        });

        var signOutAllForm = document.getElementById('signOutAllFormDevices');
        if (signOutAllForm) {
            signOutAllForm.addEventListener('submit', function(e) {
                if (!confirm("This will sign you out on every device, including this one. Continue?")) {
                    e.preventDefault();
                }
            });
        }
    </script>
}