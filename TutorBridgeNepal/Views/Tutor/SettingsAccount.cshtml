@model TutorBridgeNepal.ViewModels.TutorSettingsPageViewModel
@{
    ViewData["Title"] = "Account & security";
    ViewData["SettingsActiveSection"] = "account";
    Layout = "_SettingsLayout";
}

<div class="panel">
    <div class="panel-head">
        <h2>Account &amp; security</h2>
    </div>

    <form asp-controller="Tutor" asp-action="UpdateAccount" method="post" class="settings-form-grid">
        @Html.AntiForgeryToken()
        <div class="field">
            <label>Email address</label>
            <input type="email" name="email" class="tb-input" value="@Model.Email" required maxlength="256" />
        </div>
        <div class="field">
            <label>Phone number</label>
            <input type="text" name="phoneNumber" class="tb-input" value="@Model.PhoneNumber" placeholder="+977 98XXXXXXXX" maxlength="20" />
        </div>
        <div class="field full settings-actions">
            <button type="submit" class="tb-btn">Save changes</button>
            <a asp-controller="Tutor" asp-action="SettingsAccount" class="tb-btn-outline">Cancel</a>
        </div>
    </form>

    <div class="settings-toggle-row" style="border-top:1px solid var(--line); padding-top:1.1rem; margin-top:.3rem;">
        <div>
            <div class="settings-toggle-title">Password</div>
            <div class="settings-toggle-sub">Change your account password</div>
        </div>
        <button type="button" class="tb-btn-outline reply-toggle" data-target="changePasswordForm">Change password</button>
    </div>

    <form asp-controller="Tutor" asp-action="ChangePassword" method="post" class="settings-form-grid reply-form" id="changePasswordForm">
        @Html.AntiForgeryToken()
        <div class="field">
            <label>Current password</label>
            <input type="password" name="currentPassword" class="tb-input" required />
        </div>
        <div class="field"></div>
        <div class="field">
            <label>New password</label>
            <input type="password" name="newPassword" class="tb-input" required minlength="6" />
        </div>
        <div class="field">
            <label>Confirm new password</label>
            <input type="password" name="confirmNewPassword" class="tb-input" required minlength="6" />
        </div>
        <div class="field full settings-actions">
            <button type="submit" class="tb-btn">Change password</button>
        </div>
    </form>

    <div class="settings-toggle-row" style="border-top:1px solid var(--line); padding-top:1.1rem;">
        <div>
            <div class="settings-toggle-title">Two-factor authentication</div>
            <div class="settings-toggle-sub">Recommended for tutor accounts handling payments</div>
        </div>
        <div style="display:flex; align-items:center; gap:.7rem;">
            <span class="msc-badge" style="background:var(--soft); color:var(--muted);">@(Model.TwoFactorEnabled ? "Enabled" : "Disabled")</span>
            <button type="button" class="tb-btn" disabled title="2FA setup for tutor accounts isn't built yet - currently only available for admin accounts">Enable 2FA</button>
        </div>
    </div>

    <div class="settings-toggle-row">
        <div>
            <div class="settings-toggle-title">Active sessions</div>
            <div class="settings-toggle-sub">Sign out of TutorBridge Nepal on every device you're logged into</div>
        </div>
        <form asp-controller="Tutor" asp-action="SignOutAllDevices" method="post" id="signOutAllForm">
            @Html.AntiForgeryToken()
            <button type="submit" class="tb-btn-danger-outline">Sign out all</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.reply-toggle').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var form = document.getElementById(btn.dataset.target);
                if (form) form.classList.toggle('open');
            });
        });

        document.getElementById('signOutAllForm').addEventListener('submit', function(e) {
            if (!confirm("This will sign you out on every device, including this one. Continue?")) {
                e.preventDefault();
            }
        });
    </script>
}