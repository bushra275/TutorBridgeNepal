@model TutorBridgeNepal.ViewModels.TutorSettingsPageViewModel
@{
    ViewData["Title"] = "Notification preferences";
    ViewData["SettingsActiveSection"] = "notifications";
    Layout = "_SettingsLayout";
}

<div class="panel">
    <div class="panel-head">
        <h2>Notification preferences</h2>
    </div>
    <p class="tutor-meta mb-3" style="margin-top:-.6rem;">Saved for real, but emails/push aren't wired up yet - these just control what would be sent once that's built.</p>

    <div class="settings-toggle-row">
        <div>
            <div class="settings-toggle-title">New session requests</div>
            <div class="settings-toggle-sub">Get notified when a student requests a session</div>
        </div>
        <form asp-controller="Tutor" asp-action="UpdateNotificationPreference" method="post" class="toggle-form ajax-toggle-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="key" value="NewSessionRequests" />
            <input type="hidden" name="value" value="@(!Model.NotifyNewSessionRequests)" class="toggle-value-input" />
            <button type="submit" class="toggle-switch @(Model.NotifyNewSessionRequests ? "on" : "")" aria-label="Toggle new session request alerts"><span class="toggle-knob"></span></button>
        </form>
    </div>

    <div class="settings-toggle-row">
        <div>
            <div class="settings-toggle-title">New student messages</div>
            <div class="settings-toggle-sub">Email and push alerts when a student messages you</div>
        </div>
        <form asp-controller="Tutor" asp-action="UpdateNotificationPreference" method="post" class="toggle-form ajax-toggle-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="key" value="NewMessages" />
            <input type="hidden" name="value" value="@(!Model.NotifyNewMessages)" class="toggle-value-input" />
            <button type="submit" class="toggle-switch @(Model.NotifyNewMessages ? "on" : "")" aria-label="Toggle new message alerts"><span class="toggle-knob"></span></button>
        </form>
    </div>  
</div>