@model TutorBridgeNepal.ViewModels.TutorSettingsPageViewModel
@{
    ViewData["Title"] = "Deactivate tutor account";
    ViewData["SettingsActiveSection"] = "deactivate";
    Layout = "_SettingsLayout";
}

<div class="panel danger-panel">
    <div class="panel-head">
        <h2>Deactivate tutor account</h2>
    </div>
    <p class="tutor-meta mb-3">This signs you out, removes your profile from student search, and blocks logging back in until support reactivates it. Your bookings, reviews and messages are kept.</p>

    <form asp-controller="Tutor" asp-action="DeactivateAccount" method="post" id="deactivateAccountForm" class="settings-form-grid">
        @Html.AntiForgeryToken()
        <div class="field full">
            <label>Type <strong>DEACTIVATE</strong> to confirm</label>
            <input type="text" name="confirmText" class="tb-input" placeholder="DEACTIVATE" autocomplete="off" />
        </div>
        <div class="field full settings-actions">
            <button type="submit" class="tb-btn-danger">Deactivate my account</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('deactivateAccountForm').addEventListener('submit', function(e) {
            if (!confirm('This will deactivate your tutor account and sign you out. Are you sure?')) {
                e.preventDefault();
            }
        });
    </script>
}