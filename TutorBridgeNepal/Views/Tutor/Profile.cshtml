@model TutorBridgeNepal.ViewModels.TutorProfilePageViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Profile - TutorBridge Nepal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-dashboard.css" asp-append-version="true" />
    <style>
            /* Inline copy of the checklist's interactive styles - kept here too
                           (not just in tutor-dashboard.css) so this section still looks and
                           behaves right even if that stylesheet hasn't been refreshed. */
            .mp-doc-row {
                transition: box-shadow .15s ease, border-color .15s ease, background .15s ease;
            }

                .mp-doc-row:hover {
                    box-shadow: 0 4px 14px rgba(18, 122, 91, .08);
                    border-color: var(--green-2);
                }

                .mp-doc-row.uploaded {
                    background: var(--mint);
                    border-color: var(--mint-2);
                }

            .mp-doc-status-badge {
                display: inline-flex;
                align-items: center;
                gap: .25rem;
                font-size: .74rem;
                font-weight: 700;
                margin-top: .15rem;
            }

                .mp-doc-status-badge.success {
                    color: var(--green-dark);
                }

                .mp-doc-status-badge.pending {
                    color: var(--orange);
                }

            .mp-upload-form {
                display: flex;
                align-items: center;
                gap: .5rem;
                flex-wrap: wrap;
            }

            .mp-file-picker {
                display: inline-flex;
                align-items: center;
                gap: .4rem;
                background: #fff;
                border: 1px dashed var(--line);
                border-radius: 8px;
                padding: .45rem .7rem;
                font-size: .78rem;
                font-weight: 600;
                color: var(--muted);
                cursor: pointer;
                max-width: 190px;
                transition: border-color .15s ease, color .15s ease, background .15s ease;
            }

                .mp-file-picker:hover {
                    border-color: var(--green);
                    color: var(--green-dark);
                }

                .mp-file-picker::before {
                    content: "📎";
                    flex: 0 0 auto;
                }

                .mp-file-picker span {
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }

            .mp-upload-form.has-file .mp-file-picker {
                border-style: solid;
                border-color: var(--green);
                background: var(--mint);
                color: var(--green-dark);
            }

            .mp-file-input-native {
                position: absolute;
                width: 1px;
                height: 1px;
                padding: 0;
                margin: -1px;
                overflow: hidden;
                clip: rect(0, 0, 0, 0);
                white-space: nowrap;
                border: 0;
            }

            .mp-doc-btn {
                transition: transform .1s ease, box-shadow .15s ease;
            }

                .mp-doc-btn:hover:not(:disabled) {
                    transform: translateY(-1px);
                    box-shadow: 0 3px 8px rgba(0, 0, 0, .08);
                }

                .mp-doc-btn:disabled {
                    opacity: .5;
                    cursor: not-allowed;
                    transform: none;
                    box-shadow: none;
                }
    </style>
</head>
<body>
    <div class="dash-shell">
        @await Html.PartialAsync("_TutorTopbar")

        <div class="dash-body">
            @await Html.PartialAsync("_TutorSidebar")

            <main class="dash-main">
                <div class="page-head">
                    <div>
                        <h1>My Profile</h1>
                        <p>This is how students see you on TutorBridge Nepal</p>
                    </div>
                    <div style="display:flex; gap:.6rem;">
                        <a asp-controller="Tutor" asp-action="PreviewProfile" class="tb-btn-outline">Preview as student</a>                        <button type="submit" form="profileForm" class="tb-btn" style="min-height:38px; padding:0 1.2rem;">Save changes</button>
                    </div>
                </div>

                @if (TempData["SettingsSuccess"] != null)
                {
                    <div class="status-banner success mb-3">@TempData["SettingsSuccess"]</div>
                }
                @if (TempData["SettingsError"] != null)
                {
                    <div class="status-banner error mb-3">@TempData["SettingsError"]</div>
                }
                @if (TempData["ProfileSuccess"] != null)
                {
                    <div class="status-banner success mb-3">@TempData["ProfileSuccess"]</div>
                }
                @if (TempData["ProfileError"] != null)
                {
                    <div class="status-banner error mb-3">@TempData["ProfileError"]</div>
                }

                <!-- Identity card -->
                <div class="panel mp-identity-panel">
                    <div class="mp-identity-left">
                        @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                        {
                            <img src="@Model.PhotoUrl" alt="Profile photo" class="avatar-circle-lg mp-avatar-xl" style="object-fit:cover;" />
                        }
                        else
                        {
                            <div class="avatar-circle-lg mp-avatar-xl">@Model.Initials</div>
                        }
                        <button type="button" class="tb-btn-outline" id="tutorPhotoUploadToggle">Change photo</button>
                        <form asp-controller="Tutor" asp-action="UploadTutorPhoto" method="post" enctype="multipart/form-data" style="display:none;" id="tutorPhotoUploadForm">
                            @Html.AntiForgeryToken()
                            <input type="file" name="photo" accept=".jpg,.jpeg,.png,.webp" required onchange="this.form.requestSubmit()" />
                        </form>
                        @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                        {
                            <form asp-controller="Tutor" asp-action="RemoveTutorPhoto" method="post" data-tb-confirm="Remove your profile photo?" style="margin-top:.5rem;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="tb-btn-danger-outline">Remove</button>
                            </form>
                        }
                    </div>

                    <div class="mp-identity-mid">
                        <h2>@Model.FullName</h2>
                        <div class="mp-badges">
                            @if (Model.IsVerified)
                            {
                                <span class="msc-badge" style="background:var(--mint); color:var(--green-dark);">✓ Verified</span>
                            }
                            @if (Model.IsTopTutor)
                            {
                                <span class="top-tutor-badge">Top Tutor @Model.TopTutorYear</span>
                            }
                        </div>
                        <p class="mp-subline">
                            @string.Join(" · ", new[] { string.Join(" · ", Model.SubjectTags), Model.District != null ? (Model.Province != null ? $"{Model.District}, {Model.Province}" : Model.District) : null }.Where(x => !string.IsNullOrWhiteSpace(x)))
                        </p>
                        <p class="mp-subline muted">
                            @(Model.YearsOfExperience) year@(Model.YearsOfExperience == 1 ? "" : "s") experience · @Model.SessionsCompleted sessions completed
                        </p>
                        @if (Model.ReviewCount > 0)
                        {
                            <p class="mp-subline">
                                <span style="color:var(--orange);">@(new string('★', (int)Math.Round(Model.AverageRating)))@(new string('☆', 5 - (int)Math.Round(Model.AverageRating)))</span>
                                @Model.AverageRating.ToString("0.0") <span class="muted">(@Model.ReviewCount reviews)</span>
                            </p>
                        }
                    </div>

                    <div class="mp-identity-right">
                        <div class="mp-completion-label">Profile completion</div>
                        <div class="star-bar-track mp-completion-track">
                            <div class="star-bar-fill" style="width:@(Model.ProfileCompletionPercent)%;"></div>
                        </div>
                        <div class="mp-completion-pct">@Model.ProfileCompletionPercent%</div>
                        @if (!string.IsNullOrEmpty(Model.ProfileCompletionHint))
                        {
                            <div class="mp-completion-hint">@Model.ProfileCompletionHint</div>
                        }
                    </div>
                </div>

                <!-- Basic information -->
                <form id="profileForm" asp-controller="Tutor" asp-action="UpdateProfile" method="post" class="panel" style="margin-top:1rem;">
                    @Html.AntiForgeryToken()
                    <div class="panel-head"><h2>Basic information</h2></div>

                    <div class="settings-form-grid">
                        <div class="field">
                            <label>Full name</label>
                            <input type="text" name="fullName" class="tb-input" value="@Model.FullName" required maxlength="150" />
                        </div>
                        <div class="field">
                            <label>Display name (optional)</label>
                            <input type="text" name="displayName" class="tb-input" value="@Model.DisplayName" placeholder="e.g. Ram Sir" maxlength="60" />
                        </div>
                        <div class="field">
                            <label>District</label>
                            <select name="district" class="tb-select">
                                <option value="">Select district</option>
                                @foreach (var d in new[] { "Kathmandu", "Lalitpur", "Bhaktapur", "Pokhara", "Chitwan", "Biratnagar" })
                                {
                                    <option selected="@(Model.District == d)">@d</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label>Years of experience</label>
                            <input type="number" name="yearsOfExperience" class="tb-input" value="@Model.YearsOfExperience" min="0" max="60" />
                        </div>
                        <div class="field">
                            <label>Teaching mode</label>
                            <select name="teachingMode" class="tb-select">
                                <option value="">Select teaching mode</option>
                                @foreach (var m in new[] { "Online only", "In-person only", "Online & In-person" })
                                {
                                    <option selected="@(Model.TeachingMode == m)">@m</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label>Languages spoken</label>
                            <div class="tag-input-box">
                                <div id="languageTagList" style="display:contents;"></div>
                                <input type="text" id="languageTagInput" placeholder="+ Add" maxlength="30" />
                            </div>
                            <input type="hidden" name="languages" id="languagesHidden" value="@string.Join(",", Model.Languages)" />
                        </div>
                        <div class="field full">
                            <label>Bio / About me</label>
                            <textarea name="bio" class="tb-input" style="min-height:100px; resize:vertical;" maxlength="500">@Model.Bio</textarea>
                        </div>
                    </div>
                </form>

                <!-- Subjects -->
                <div class="panel" style="margin-top:1rem;">
                    <div class="panel-head" style="display:flex; justify-content:space-between; align-items:center;">
                        <h2>Subjects</h2>
                        <button type="button" class="tb-btn-outline" style="min-height:36px; padding:0 1rem; font-size:.82rem;" id="addSubjectToggle">+ Add</button>
                    </div>

                    <form asp-controller="Tutor" asp-action="AddSubject" method="post" class="mp-add-subject-form" id="addSubjectForm">
                        @Html.AntiForgeryToken()
                        <input type="text" name="subject" placeholder="Subject (e.g. Chemistry)" maxlength="60" required />
                        <input type="text" name="description" placeholder="Description (e.g. Grade 9-12)" maxlength="120" />
                        <button type="submit" class="tb-btn" style="min-height:38px; padding:0 1rem; font-size:.82rem;">Add</button>
                    </form>

                    @if (!Model.Subjects.Any())
                    {
                        <p class="empty-state">No subjects added yet.</p>
                    }
                    else
                    {
                        @foreach (var s in Model.Subjects)
                        {
                            <div class="mp-subject-row">
                                <div class="mp-subject-info">
                                    <div class="mp-subject-name">@s.Subject</div>
                                    @if (!string.IsNullOrWhiteSpace(s.Description))
                                    {
                                        <div class="mp-subject-desc">@s.Description</div>
                                    }
                                </div>

                                <button type="button" class="mp-edit-link subject-edit-toggle" data-target="edit-subject-@s.Id">Edit</button>
                            </div>

                            <form asp-controller="Tutor" asp-action="UpdateSubject" method="post" class="mp-subject-edit-form" id="edit-subject-@s.Id">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <input type="text" name="subject" value="@s.Subject" maxlength="60" required />
                                <input type="text" name="description" value="@s.Description" placeholder="Description" maxlength="120" />
                                <button type="submit" class="tb-btn" style="min-height:34px; padding:0 .9rem; font-size:.8rem;">Save</button>
                            </form>
                        }
                    }
                </div>

                <!-- Teaching style -->
                <!-- Not its own <form>: the hidden tag field below is tied to profileForm via
                 the form="profileForm" attribute, so it saves together with Basic
                 information when "Save changes" is clicked. No separate submit,
                 no page reload, nothing else on the page gets reset. -->
                <div class="panel" style="margin-top:1rem;">
                    <div class="panel-head"><h2>Teaching style</h2></div>

                    <div class="tag-input-box">
                        <div id="styleTagList" style="display:contents;"></div>
                        <input type="text" id="styleTagInput" placeholder="+ Add tag" maxlength="30" />
                    </div>
                    <input type="hidden" name="teachingStyle" id="teachingStyleHidden" form="profileForm" value="@string.Join(",", Model.TeachingStyleTags)" />
                </div>

                <!-- Credentials & documents -->
                <div class="panel" style="margin-top:1rem;">
                    <div class="panel-head" style="display:flex; justify-content:space-between; align-items:center;">
                        <h2>Credentials &amp; documents</h2>
                    </div>

                    <div class="mp-doc-checklist">
                        @foreach (var doc in Model.RequiredDocuments)
                        {
                            <div class="mp-doc-row @(doc.IsUploaded ? "uploaded" : "")">
                                <div class="mp-doc-info">
                                    <span class="mp-doc-icon">@doc.Icon</span>
                                    <div>
                                        <div class="mp-doc-label">@doc.Label</div>
                                        @if (doc.IsUploaded)
                                        {
                                            <div class="mp-doc-status-badge success">✓ Uploaded @(doc.UploadedAt?.ToString("MMM d, yyyy"))</div>
                                        }
                                        else
                                        {
                                            <div class="mp-doc-status-badge pending">Not uploaded yet</div>
                                        }
                                    </div>
                                </div>
                                <div class="mp-doc-actions">
                                    @if (doc.IsUploaded)
                                    {
                                        <a class="mp-doc-btn" asp-action="DownloadOwnVerificationDocument" asp-route-credentialId="@doc.CredentialId" target="_blank">View</a>
                                    }
                                    else
                                    {
                                        <form asp-action="UploadVerificationDocument" method="post" enctype="multipart/form-data" class="mp-upload-form" data-doc-form>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="documentType" value="@doc.DocumentType" />
                                            <label class="mp-file-picker">
                                                <input type="file" name="file" accept=".pdf,.jpg,.jpeg,.png" required class="mp-file-input-native" data-file-input />
                                                <span data-file-label>Choose file</span>
                                            </label>
                                            <button type="submit" class="mp-doc-btn mp-doc-btn-primary" data-upload-btn disabled>Upload</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <p class="mp-doc-hint">PDF, JPG, or PNG - up to 10 MB. These are reviewed by an admin on the Tutor Verification page.</p>
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            // --- Draft autosave for Basic information -------------------------------
            // Add subject, Edit subject, and photo/document uploads are separate forms
            // that do a normal full-page POST + reload. That used to wipe out anything
            // typed into Basic information that hadn't been saved yet. Fix: keep a
            // live draft in sessionStorage, restore it after any reload, and only
            // clear it once "Save changes" is actually clicked.
            (function() {
                var DRAFT_KEY = 'tbProfileDraft';
                var form = document.getElementById('profileForm');
                if (!form) return;

                var fieldNames = ['fullName', 'displayName', 'district', 'yearsOfExperience', 'teachingMode', 'bio'];

                function readDraft() {
                    try {
                        return JSON.parse(sessionStorage.getItem(DRAFT_KEY) || 'null');
                    } catch (e) {
                        return null;
                    }
                }

                function saveDraft() {
                    var draft = {};
                    fieldNames.forEach(function(name) {
                        var el = form.elements[name];
                        if (el) draft[name] = el.value;
                    });
                    var languagesHidden = document.getElementById('languagesHidden');
                    var styleHidden = document.getElementById('teachingStyleHidden');
                    if (languagesHidden) draft.languages = languagesHidden.value;
                    if (styleHidden) draft.teachingStyle = styleHidden.value;
                    sessionStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
                }

                // Restore any draft left over from before an unrelated form reloaded the page.
                var draft = readDraft();
                if (draft) {
                    fieldNames.forEach(function(name) {
                        var el = form.elements[name];
                        if (el && draft[name] !== undefined) el.value = draft[name];
                    });
                    if (draft.languages !== undefined) {
                        var languagesHidden = document.getElementById('languagesHidden');
                        if (languagesHidden) languagesHidden.value = draft.languages;
                    }
                    if (draft.teachingStyle !== undefined) {
                        var styleHidden = document.getElementById('teachingStyleHidden');
                        if (styleHidden) styleHidden.value = draft.teachingStyle;
                    }
                }

                // Keep the draft up to date as the user types/selects.
                form.addEventListener('input', saveDraft);
                form.addEventListener('change', saveDraft);

                // Once the user actually saves, the draft is no longer needed.
                form.addEventListener('submit', function() {
                    sessionStorage.removeItem(DRAFT_KEY);
                });
            })();

            var tutorPhotoToggle = document.getElementById('tutorPhotoUploadToggle');
            var tutorPhotoForm = document.getElementById('tutorPhotoUploadForm');
            if (tutorPhotoToggle && tutorPhotoForm) {
                tutorPhotoToggle.addEventListener('click', function() {
                    tutorPhotoForm.querySelector('input[type="file"]').click();
                });
            }

            // Reusable comma-separated tag chip editor (same pattern as Student Settings' subject tags).
            // onChange (optional) fires after every add/remove - used to auto-submit the
            // Teaching style form, since that panel has no visible Save button of its own.
            function initTagEditor(hiddenId, listId, inputId, chipClass, onChange) {
                var hidden = document.getElementById(hiddenId);
                var list = document.getElementById(listId);
                var input = document.getElementById(inputId);
                if (!hidden || !list || !input) return;

                function currentTags() {
                    return (hidden.value || '').split(',').map(function(t) { return t.trim(); }).filter(function(t) { return t.length > 0; });
                }

                function render() {
                    var tags = currentTags();
                    list.innerHTML = '';
                    tags.forEach(function(tag) {
                        var chip = document.createElement('span');
                        chip.className = chipClass;
                        chip.textContent = tag + ' ';
                        var remove = document.createElement('button');
                        remove.type = 'button';
                        remove.className = 'tag-remove-btn';
                        remove.textContent = '×';
                        remove.addEventListener('click', function() {
                            hidden.value = currentTags().filter(function(t) { return t !== tag; }).join(',');
                            render();
                            if (onChange) onChange();
                        });
                        chip.appendChild(remove);
                        list.appendChild(chip);
                    });
                }

                input.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        var val = input.value.trim();
                        if (val.length === 0) return;
                        var tags = currentTags();
                        if (tags.indexOf(val) === -1) {
                            tags.push(val);
                            hidden.value = tags.join(',');
                            render();
                            if (onChange) onChange();
                        }
                        input.value = '';
                    }
                });

                render();
            }

            initTagEditor('languagesHidden', 'languageTagList', 'languageTagInput', 'subject-chip');
            // Teaching style tags now live in the same hidden field/form as everything else
            // on this page (see form="profileForm" on #teachingStyleHidden above), so - just
            // like the Languages tags - adding/removing a tag only updates the hidden input
            // locally. It's saved when "Save changes" is clicked, same as Bio and the rest.
            initTagEditor('teachingStyleHidden', 'styleTagList', 'styleTagInput', 'subject-chip');

            // Toggle inline "edit subject" panels
            document.querySelectorAll('.subject-edit-toggle').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var form = document.getElementById(btn.dataset.target);
                    if (form) form.classList.toggle('open');
                });
            });

            // Toggle the "add subject" form
            var addToggle = document.getElementById('addSubjectToggle');
            var addForm = document.getElementById('addSubjectForm');
            if (addToggle && addForm) {
                addToggle.addEventListener('click', function() {
                    addForm.classList.toggle('open');
                });
            }

            // Verification document upload: show the chosen file name, only
            // enable Upload once a file is picked, and show progress on submit.
            document.querySelectorAll('[data-doc-form]').forEach(function(form) {
                var input = form.querySelector('[data-file-input]');
                var label = form.querySelector('[data-file-label]');
                var button = form.querySelector('[data-upload-btn]');

                input.addEventListener('change', function() {
                    if (input.files && input.files.length > 0) {
                        label.textContent = input.files[0].name;
                        form.classList.add('has-file');
                        button.disabled = false;
                    } else {
                        label.textContent = 'Choose file';
                        form.classList.remove('has-file');
                        button.disabled = true;
                    }
                });

                form.addEventListener('submit', function() {
                    button.disabled = true;
                    button.textContent = 'Uploading…';
                });
            });
    </script>
</body>
</html>