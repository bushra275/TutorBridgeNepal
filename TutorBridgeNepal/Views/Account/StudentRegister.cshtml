@model TutorBridgeNepal.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Student Register";
}

<main class="auth-page">
    <aside class="auth-side">
        <div class="auth-side-content">
            <h2 class="auth-logo serif">TutorBridge Nepal</h2>
            <p class="auth-small">Start your learning journey today</p>

            <div class="benefit-panel text-center">
                <h2 class="serif mb-0">Join Nepal's Fastest</h2>
                <h2 class="serif text-white">Growing Tutor Network</h2>
            </div>

            <h3 class="mt-5 fs-6 fw-bold">What you get as a student:</h3>
            <ul class="check-list">
                <li>Access 500+ verified tutors across Nepal</li>
                <li>Book sessions in Math, Science, English & more</li>
                <li>SEE Prep, NEB Board & IELTS specialists</li>
                <li>Flexible scheduling, transparent NPR pricing</li>
                <li>Track your progress and session history</li>
                <li>Tutors in all 18 districts of Nepal</li>
            </ul>
        </div>
        <div class="auth-sdg">SDG 4: Quality Education</div>
    </aside>

    <section class="auth-main">
        <div class="auth-top">
            <a class="back-link" asp-controller="Role" asp-action="Select">← Back to role selection</a>
        </div>

        <div class="auth-panel">
            <div class="auth-heading">
                <h1 class="serif">Create Your Student Account</h1>
                <p>It only takes 2 minutes to get started.</p>
            </div>

            <div class="progress-steps" id="registerSteps">
                <div class="step-dot active" data-step-dot="1"><span>1</span>Account</div>
                <div class="step-dot" data-step-dot="2"><span>2</span>Details</div>
                <div class="step-dot" data-step-dot="3"><span>3</span>Confirm</div>
            </div>

            <form asp-action="Register" method="post" id="registerForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Role" />
                <div asp-validation-summary="ModelOnly"></div>

                <section class="register-step active" data-step="1">
                    <div class="form-grid">
                        <div class="field">
                            <label asp-for="FullName">Full Name</label>
                            <input asp-for="FullName" class="tb-input step-required" placeholder="e.g. Priya Shrestha" />
                        </div>
                        <div class="field">
                            <label asp-for="Email">Email Address</label>
                            <input asp-for="Email" class="tb-input step-required" placeholder="name@example.com" id="emailInput" />
                            <span class="field-error" id="emailError" style="display:none; color:#bf3030; font-size:.78rem;">Enter a valid email address.</span>
                        </div>
                        <div class="field">
                            <label asp-for="PhoneNumber">Phone Number</label>
                            <input asp-for="PhoneNumber" class="tb-input step-required" placeholder="98XXXXXXXX" id="phoneInput" maxlength="10" />
                            <span class="field-error" id="phoneError" style="display:none; color:#bf3030; font-size:.78rem;">Enter a valid 10-digit Nepali mobile number (e.g. 98XXXXXXXX).</span>
                        </div>
                        <div class="field">
                            <label asp-for="District">District</label>
                            <select asp-for="District" class="tb-select step-required">
                                <option value="">Select district</option>
                                <option>Kathmandu</option>
                                <option>Lalitpur</option>
                                <option>Bhaktapur</option>
                                <option>Pokhara</option>
                                <option>Chitwan</option>
                                <option>Biratnagar</option>
                            </select>
                        </div>
                    </div>
                </section>

                <section class="register-step" data-step="2">
                    <div class="form-grid">
                        <div class="field full">
                            <label asp-for="GradeLevel">Grade / Level</label>
                            <input asp-for="GradeLevel" class="tb-input step-required" placeholder="e.g. Grade 10 (SEE)" />
                        </div>

                        <div class="field">
                            <label asp-for="Password">Password</label>
                            <div class="password-wrap">
                                <input asp-for="Password" type="password" class="tb-input step-required" placeholder="Create a strong password" id="passwordInput" />
                                <span class="eye-dot"></span>
                            </div>
                        </div>
                        <div class="field">
                            <label asp-for="ConfirmPassword">Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="tb-input step-required" placeholder="Re-enter password" id="confirmPasswordInput" />
                        </div>
                        <div class="field full">
                            <label>Password Strength</label>
                            <div class="strength"><span id="strengthBar"></span></div>
                            <div class="strength-text" id="strengthText">Start typing a password</div>
                        </div>
                    </div>
                </section>

                <section class="register-step" data-step="3">
                    <div class="confirm-box">
                        <h3>Confirm your details</h3>
                        <p>Please review your information before creating your account.</p>
                        <div class="confirm-grid">
                            <div><span>Role</span><strong>Student</strong></div>
                            <div><span>Full Name</span><strong id="confirmName">-</strong></div>
                            <div><span>Email</span><strong id="confirmEmail">-</strong></div>
                            <div><span>District</span><strong id="confirmDistrict">-</strong></div>
                            <div><span>Grade / Level</span><strong id="confirmStudy">-</strong></div>
                            <div><span>Password</span><strong id="confirmPasswordStatus">Not checked</strong></div>
                        </div>
                    </div>

                    <label class="terms-line">
                        <input class="box-check step-required" type="checkbox" checked id="termsCheck" />
                        I agree to the <a class="link-green" asp-controller="Home" asp-action="Terms">Terms of Service</a> and <a class="link-green" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                    </label>
                </section>

                <div class="register-actions">
                    <button class="tb-btn-outline" type="button" id="prevStep" disabled>Back</button>
                    <button class="tb-btn" type="button" id="nextStep">Next</button>
                    <button class="tb-btn d-none" type="submit" id="submitRegister">Create Account</button>
                </div>
            </form>

            <div class="divider">or sign up with</div>
            <form asp-action="GoogleLogin" asp-controller="Account" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="role" value="Student" />
                <button class="google-btn" type="submit"><span class="g-dot">G</span><span>Sign up with Google</span><span></span></button>
            </form>            <p class="auth-bottom">Already have an account? <a class="link-green" asp-action="StudentLogin">Log in</a></p>
            <p class="auth-bottom">Signing up to teach? <a class="link-green" asp-action="TutorRegister">Register as Tutor</a></p>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            let currentStep = 1;
            const totalSteps = 3;
            const steps = document.querySelectorAll(".register-step");
            const dots = document.querySelectorAll("[data-step-dot]");
            const prevButton = document.getElementById("prevStep");
            const nextButton = document.getElementById("nextStep");
            const submitButton = document.getElementById("submitRegister");
            const passwordInput = document.getElementById("passwordInput");
            const confirmPasswordInput = document.getElementById("confirmPasswordInput");
            const strengthBar = document.getElementById("strengthBar");
            const strengthText = document.getElementById("strengthText");

            function showStep(step) {
                currentStep = step;
                steps.forEach(item => item.classList.toggle("active", Number(item.dataset.step) === step));
                dots.forEach(item => item.classList.toggle("active", Number(item.dataset.stepDot) <= step));

                prevButton.disabled = step === 1;
                nextButton.classList.toggle("d-none", step === totalSteps);
                submitButton.classList.toggle("d-none", step !== totalSteps);

                if (step === 3) {
                    updateConfirm();
                }
            }

            function getStepFields(step) {
                return document.querySelectorAll(`.register-step[data-step="${step}"] .step-required`);
            }

            const emailInput = document.getElementById("emailInput");
            const emailError = document.getElementById("emailError");
            const phoneInput = document.getElementById("phoneInput");
            const phoneError = document.getElementById("phoneError");

            // Deliberately not a fully RFC-5322-compliant email pattern -
            // this only needs to catch obviously malformed input before it
            // reaches the server, which still re-validates with
            // [EmailAddress] regardless of what the browser lets through.
            const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/; const phonePattern = /^9[678]\d{8}$/;

            function validateCurrentStep() {
                let isValid = true;
                getStepFields(currentStep).forEach(field => {
                    const empty = field.type === "checkbox" ? !field.checked : !field.value.trim();
                    field.classList.toggle("input-error", empty);
                    if (empty) isValid = false;
                });

                if (currentStep === 1) {
                    const emailValid = emailPattern.test(emailInput.value.trim());
                    emailInput.classList.toggle("input-error", !emailValid);
                    emailError.style.display = emailValid ? "none" : "block";
                    if (!emailValid) isValid = false;

                    const phoneValid = phonePattern.test(phoneInput.value.trim());
                    phoneInput.classList.toggle("input-error", !phoneValid);
                    phoneError.style.display = phoneValid ? "none" : "block";
                    if (!phoneValid) isValid = false;
                }

                if (currentStep === 2) {
                    const password = passwordInput.value;
                    const confirmPassword = confirmPasswordInput.value;
                    const passwordsMatch = password === confirmPassword && confirmPassword.length > 0;
                    confirmPasswordInput.classList.toggle("input-error", !passwordsMatch);
                    if (!passwordsMatch) isValid = false;
                }

                return isValid;
            }

            function scorePassword(password) {
                let score = 0;
                if (password.length >= 6) score++;
                if (password.length >= 10) score++;
                if (/[A-Z]/.test(password)) score++;
                if (/[a-z]/.test(password)) score++;
                if (/[0-9]/.test(password)) score++;
                if (/[^A-Za-z0-9]/.test(password)) score++;
                return score;
            }

            function updateStrength() {
                const password = passwordInput.value;
                const score = scorePassword(password);
                let label = "Start typing a password";
                let width = "0%";
                let color = "#deded8";

                if (password.length > 0 && score <= 2) {
                    label = "Weak - use 6+ characters, numbers and capitals";
                    width = "28%";
                    color = "#d9534f";
                } else if (score <= 4 && password.length > 0) {
                    label = "Good - add symbols for Strong";
                    width = "65%";
                    color = "#47aa80";
                } else if (score >= 5) {
                    label = "Strong password";
                    width = "100%";
                    color = "#127a5b";
                }

                strengthBar.style.width = width;
                strengthBar.style.background = color;
                strengthText.textContent = label;
                strengthText.style.color = color;
            }

            function valueOf(name) {
                const field = document.querySelector(`[name="${name}"]`);
                return field && field.value ? field.value : "-";
            }

            function updateConfirm() {
                document.getElementById("confirmName").textContent = valueOf("FullName");
                document.getElementById("confirmEmail").textContent = valueOf("Email");
                document.getElementById("confirmDistrict").textContent = valueOf("District");
                document.getElementById("confirmStudy").textContent = valueOf("GradeLevel");

                const password = passwordInput.value;
                const confirmPassword = confirmPasswordInput.value;
                document.getElementById("confirmPasswordStatus").textContent =
                    password && password === confirmPassword ? "Password matched" : "Password not matched";
            }

            // Catches "fat finger" typos of well-known providers - e.g.
            // gmial.com, gamil.com, yaho.com - even when the typo happens to
            // be a real, mail-receiving domain (some typo domains are
            // deliberately squatted for exactly this confusion, so MX alone
            // can't catch them). Levenshtein distance of 1-2 against a short
            // list of major providers is enough to catch genuine typos
            // without false-positiving on unrelated real domains.
            const commonDomains = ["gmail.com", "yahoo.com", "outlook.com", "hotmail.com", "icloud.com", "live.com"];

            function levenshtein(a, b) {
                const dp = Array.from({ length: a.length + 1 }, (_, i) => [i, ...Array(b.length).fill(0)]);
                for (let j = 0; j <= b.length; j++) dp[0][j] = j;
                for (let i = 1; i <= a.length; i++) {
                    for (let j = 1; j <= b.length; j++) {
                        dp[i][j] = a[i - 1] === b[j - 1]
                            ? dp[i - 1][j - 1]
                            : 1 + Math.min(dp[i - 1][j], dp[i][j - 1], dp[i - 1][j - 1]);
                    }
                }
                return dp[a.length][b.length];
            }

            function suggestDomainFix(email) {
                const atIndex = email.lastIndexOf("@@");
                if (atIndex === -1) return null;
                const domain = email.slice(atIndex + 1).toLowerCase();
                if (commonDomains.includes(domain)) return null;

                for (const known of commonDomains) {
                    if (levenshtein(domain, known) <= 2) {
                        return email.slice(0, atIndex + 1) + known;
                    }
                }
                return null;
            }

            async function checkEmailDomain(email) {                try {
                    const res = await fetch(`/Account/CheckEmailDomain?email=${encodeURIComponent(email)}`);
                    const data = await res.json();
                    return data.valid;
                } catch {
                    return true; // don't block registration over a network hiccup
                }
            }

            let typoSuggestion = null;

            nextButton.addEventListener("click", async () => {
                if (!validateCurrentStep()) return;

                if (currentStep === 1) {
                    const email = emailInput.value.trim();

                    // If they just accepted a suggested fix (clicked "Use
                    // this instead" below), skip straight past the typo
                    // check this time and go on to the domain check.
                    const suggestion = (email !== typoSuggestion) ? suggestDomainFix(email) : null;
                    if (suggestion) {
                        emailInput.classList.add("input-error");
                        emailError.innerHTML = `Did you mean <a href="#" id="applySuggestion" style="font-weight:700;">${suggestion}</a>?`;
                        emailError.style.display = "block";
                        typoSuggestion = suggestion;

                        document.getElementById("applySuggestion").addEventListener("click", (e) => {
                            e.preventDefault();
                            emailInput.value = suggestion;
                            emailInput.classList.remove("input-error");
                            emailError.style.display = "none";
                        });
                        return;
                    }

                    nextButton.disabled = true;
                    const originalLabel = nextButton.textContent;
                    nextButton.textContent = "Checking email...";

                    const domainOk = await checkEmailDomain(email);

                    nextButton.disabled = false;
                    nextButton.textContent = originalLabel;

                    if (!domainOk) {
                        emailInput.classList.add("input-error");
                        emailError.textContent = "This email domain doesn't appear to be able to receive mail.";
                        emailError.style.display = "block";
                        return;
                    }

                    emailError.textContent = "Enter a valid email address.";
                }

                showStep(Math.min(currentStep + 1, totalSteps));
            });

            prevButton.addEventListener("click", () => {
                showStep(Math.max(currentStep - 1, 1));
            });

            passwordInput.addEventListener("input", updateStrength);
            showStep(1);
            updateStrength();
        })();
    </script>

    <script src="~/js/tb-confirm.js" asp-append-version="true"></script>
}