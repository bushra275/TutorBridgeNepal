@model TutorBridgeNepal.ViewModels.VerifyEmailViewModel
@{
    ViewData["Title"] = "Verify your email";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify your email - TutorBridge Nepal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-shell d-flex align-items-center justify-content-center" style="min-height:100vh;">
        <div class="auth-card" style="max-width:420px; width:100%; background:#fff; border-radius:14px; padding:2rem; box-shadow:0 8px 30px rgba(0,0,0,.08);">
            <h1 style="font-size:1.4rem; font-weight:800; margin-bottom:.3rem;">Verify your email</h1>
            <p style="color:var(--muted); font-size:.9rem; margin-bottom:1.3rem;">
                We sent a 6-digit code to <strong>@Model.Email</strong>. Enter it below to finish setting up your account.
            </p>

            @if (TempData["DevOtpCode"] != null)
            {
                <div class="status-banner info mb-3">
                    Email sending isn't configured yet, so here's your code for testing: <strong>@TempData["DevOtpCode"]</strong>
                </div>
            }

            @if (TempData["SettingsSuccessGlobal"] != null)
            {
                <div class="status-banner success mb-3">@TempData["SettingsSuccessGlobal"]</div>
            }

            @if (TempData["SettingsError"] != null)
            {
                <div class="status-banner error mb-3">@TempData["SettingsError"]</div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="status-banner error mb-3">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-controller="Account" asp-action="VerifyEmail" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />
                <div class="field mb-3">
                    <label class="mb-1" style="font-size:.85rem; font-weight:700;">Verification code</label>
                    <input asp-for="Code" class="tb-input" style="min-height:46px; padding:.6rem 1rem; letter-spacing:4px; font-size:1.2rem; text-align:center;" maxlength="6" autocomplete="one-time-code" />
                </div>
                <button type="submit" class="tb-btn" style="width:100%;">Verify and continue</button>
            </form>

            <form asp-controller="Account" asp-action="ResendEmailOtp" method="post" class="mt-3 text-center">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="@Model.Email" />
                <button type="submit" class="btn btn-link p-0" style="font-size:.85rem;">Resend code</button>
            </form>
        </div>
    </div>
</body>
</html>