@model TutorBridgeNepal.ViewModels.AdminSessionLogsViewModel
@{
    ViewData["Title"] = "Session Logs";
    Layout = null;

    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    string TabUrl(string tab) => Url.Action("SessionLogs", new
    {
        tab,
        search = Model.Search,
        subject = Model.SubjectFilter,
        status = Model.StatusFilter,
        dateRange = Model.DateRangeFilter,
        district = Model.DistrictFilter,
        sort = Model.Sort,
        page = 1,
        pageSize = Model.PageSize
    })!;

    string PageUrl(int page) => Url.Action("SessionLogs", new
    {
        tab = Model.ActiveTab,
        search = Model.Search,
        subject = Model.SubjectFilter,
        status = Model.StatusFilter,
        dateRange = Model.DateRangeFilter,
        district = Model.DistrictFilter,
        sort = Model.Sort,
        page,
        pageSize = Model.PageSize
    })!;

    string StatusPillClass(string status) => status switch
    {
        "Live" => "pill sl-pill-live",
        "Completed" => "pill pill-active",
        "Cancelled" => "pill pill-suspended",
        "Disputed" => "pill sl-pill-disputed",
        "Missed" => "pill sl-pill-missed",
        "Upcoming" => "pill pill-pending2",
        _ => "pill pill-pending2"
    };

    var rangeStart = Model.TotalMatching == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    var rangeEnd = Math.Min(Model.Page * Model.PageSize, Model.TotalMatching);

    string TrendBadgeClass(int? trend) => trend switch { null => "neutral", >= 0 => "up", _ => "urgent" };
    string TrendBadgeText(int? trend) => trend switch { null => "New", >= 0 => $"+{trend}%", _ => $"{trend}%" };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Session Logs - TutorBridge Nepal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="dash-shell">

        <header class="dash-topbar">
            <a class="tb-brand" asp-controller="Home" asp-action="Index">TutorBridge <span>Nepal</span></a>
            <div class="dash-search">
                <input type="text" placeholder="Search users, sessions..." />
            </div>
            <span class="admin-chip">Admin</span>
            <div class="dash-topbar-right">
                @await Html.PartialAsync("_AdminNotifBell")
                @await Html.PartialAsync("_AdminProfileDropdown")
            </div>
        </header>

        <div class="dash-body">
            <aside class="dash-sidebar">
                <div class="dash-user">
                    @if (!string.IsNullOrEmpty(ViewData["AdminProfilePhotoUrl"] as string))
                    {
                        <div class="avatar" style="padding:0; overflow:hidden;"><img src="@(ViewData["AdminProfilePhotoUrl"] as string)" alt="@Model.AdminName" style="width:100%; height:100%; object-fit:cover; border-radius:50%;" /></div>
                    }
                    else
                    {
                        <div class="avatar">@Model.AdminInitials</div>
                    }
                    <div>
                        <div class="name">@Model.AdminName</div>
                        <div class="meta">Platform Administrator</div>
                        <span class="role-chip" style="background:#fff1d5;color:#a96808;">Super Admin</span>
                    </div>
                </div>

                <ul class="dash-nav">
                    <li><a asp-controller="Admin" asp-action="Dashboard"><span class="nav-icon">📊</span> Dashboard</a></li>
                    <li><a asp-controller="Admin" asp-action="UserManagement"><span class="nav-icon">👥</span> User Management</a></li>
                    <li>
                        <a asp-controller="Admin" asp-action="TutorVerification">
                            <span class="nav-icon">✅</span> Tutor Verification
                            @if ((int)(ViewData["SidebarPendingVerificationsCount"] ?? 0) > 0)
                            {
                                <span class="badge-count">@ViewData["SidebarPendingVerificationsCount"]</span>
                            }
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="SessionLogs" class="active">
                            <span class="nav-icon">🗒️</span> Session Logs
                        </a>
                    </li>
                    <li><a asp-controller="Admin" asp-action="Reports"><span class="nav-icon">📈</span> Reports</a></li>
                    <li>
                        <a asp-controller="Admin" asp-action="Complaints">
                            <span class="nav-icon">⚠️</span> Complaints
                            @if ((int)(ViewData["SidebarOpenComplaintsCount"] ?? 0) > 0)
                            {
                                <span class="badge-count">@ViewData["SidebarOpenComplaintsCount"]</span>
                            }
                        </a>
                    </li>
                    <li><a asp-controller="Admin" asp-action="Notifications"><span class="nav-icon">🔔</span> Notifications</a></li>
                    <li><a asp-controller="Admin" asp-action="Settings"><span class="nav-icon">⚙️</span> Settings</a></li>
                </ul>

                <ul class="dash-nav-secondary">
                    <li><a asp-controller="Account" asp-action="Logout"><span class="nav-icon">↩️</span> Log out</a></li>
                </ul>
            </aside>

            <main class="dash-main">
                <div class="dash-greeting" style="display:flex;align-items:flex-start;justify-content:space-between;">
                    <div>
                        <h1>Session Logs</h1>
                        <p>Complete record of all tutoring sessions across the platform</p>
                    </div>
                    <a class="um-btn-outline" asp-action="ExportSessionLogsCsv" asp-route-tab="@Model.ActiveTab" asp-route-search="@Model.Search" asp-route-subject="@Model.SubjectFilter" asp-route-status="@Model.StatusFilter" asp-route-dateRange="@Model.DateRangeFilter" asp-route-district="@Model.DistrictFilter">Export CSV</a>
                </div>

                <!-- KPI strip -->
                <div class="kpi-row kpi-row-4">
                    <div class="kpi-card">
                        <div class="kpi-top">
                            <span class="label">Total sessions</span>
                            <span class="kpi-badge @TrendBadgeClass(Model.TotalSessionsTrendPercent)">@TrendBadgeText(Model.TotalSessionsTrendPercent)</span>
                        </div>
                        <div class="kpi-value">@Model.TotalSessions.ToString("N0")</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-top">
                            <span class="label">Completed</span>
                            <span class="kpi-badge neutral">@Model.CompletedPercent%</span>
                        </div>
                        <div class="kpi-value" style="color:var(--green);">@Model.CompletedCount.ToString("N0")</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-top">
                            <span class="label">Ongoing now</span>
                            @if (Model.OngoingNowCount > 0)
                            {
                                <span class="kpi-badge sl-live-badge">Live</span>
                            }
                        </div>
                        <div class="kpi-value" style="color:var(--orange);">@Model.OngoingNowCount</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-top">
                            <span class="label">Cancelled</span>
                            <span class="kpi-badge urgent">@Model.CancelledPercent%</span>
                        </div>
                        <div class="kpi-value" style="color:var(--danger);">@Model.CancelledCount.ToString("N0")</div>
                    </div>
                </div>

                <!-- Tabs -->
                <div class="um-tabs">
                    <a class="um-tab @(Model.ActiveTab == "all" ? "active" : "")" href="@TabUrl("all")">All sessions (@Model.AllTabCount.ToString("N0"))</a>
                    <a class="um-tab @(Model.ActiveTab == "completed" ? "active" : "")" href="@TabUrl("completed")">Completed</a>
                    <a class="um-tab @(Model.ActiveTab == "ongoing" ? "active" : "")" href="@TabUrl("ongoing")">Ongoing (@Model.OngoingTabCount)</a>
                    <a class="um-tab @(Model.ActiveTab == "cancelled" ? "active" : "")" href="@TabUrl("cancelled")">Cancelled</a>
                    <a class="um-tab @(Model.ActiveTab == "disputed" ? "active" : "")" href="@TabUrl("disputed")">Disputed@(Model.DisputedTabCount > 0 ? $" ({Model.DisputedTabCount})" : "")</a>
                </div>

                <!-- Filters -->
                <form method="get" asp-action="SessionLogs" id="filterForm">
                    <input type="hidden" name="tab" value="@Model.ActiveTab" />
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                    <div class="um-toolbar">
                        <div class="um-search">
                            <input type="text" name="search" value="@Model.Search" placeholder="Search student, tutor or ID..." />
                        </div>
                        <select class="um-select" name="subject" onchange="this.form.submit()">
                            <option value="">Subject</option>
                            @foreach (var s in Model.Subjects)
                            {
                                <option value="@s" selected="@(Model.SubjectFilter == s)">@s</option>
                            }
                        </select>
                        <select class="um-select" name="status" onchange="this.form.submit()">
                            <option value="">Status</option>
                            @foreach (var s in new[] { "Live", "Completed", "Cancelled", "Disputed", "Missed", "Upcoming", "Pending" })
                            {
                                <option value="@s" selected="@(Model.StatusFilter == s)">@s</option>
                            }
                        </select>
                        <select class="um-select" name="dateRange" onchange="this.form.submit()">
                            <option value="all" selected="@(Model.DateRangeFilter == "all")">Date range</option>
                            <option value="last7" selected="@(Model.DateRangeFilter == "last7")">Last 7 days</option>
                            <option value="last30" selected="@(Model.DateRangeFilter == "last30")">Last 30 days</option>
                            <option value="last90" selected="@(Model.DateRangeFilter == "last90")">Last 90 days</option>
                        </select>
                        <select class="um-select" name="district" onchange="this.form.submit()">
                            <option value="">District</option>
                            @foreach (var d in Model.Districts)
                            {
                                <option value="@d" selected="@(Model.DistrictFilter == d)">@d</option>
                            }
                        </select>
                        <select class="um-select um-select-sort" name="sort" onchange="this.form.submit()">
                            <option value="newest" selected="@(Model.Sort == "newest")">Sort: Newest first</option>
                            <option value="oldest" selected="@(Model.Sort == "oldest")">Sort: Oldest first</option>
                            <option value="student_asc" selected="@(Model.Sort == "student_asc")">Sort: Student (A-Z)</option>
                            <option value="tutor_asc" selected="@(Model.Sort == "tutor_asc")">Sort: Tutor (A-Z)</option>
                        </select>
                    </div>
                </form>

                <div class="um-table-wrap">
                    @if (Model.Rows.Any())
                    {
                        <table class="um-table">
                            <thead>
                                <tr>
                                    <th>Session ID</th>
                                    <th>Student</th>
                                    <th>Tutor</th>
                                    <th>Subject</th>
                                    <th>Date &amp; Time</th>
                                    <th>Duration</th>
                                    <th>Status</th>
                                    <th>Mode</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.Rows)
                                {
                                    <tr class="@(s.IsDisputed ? "sl-row-disputed" : "")">
                                        <td>@s.SessionCode</td>
                                        <td>
                                            <div class="um-user-cell">
                                                <div class="avatar">@s.StudentInitials</div>
                                                <div class="um-user-name">@s.StudentName</div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="um-user-cell">
                                                <div class="avatar purple">@s.TutorInitials</div>
                                                <div class="um-user-name">@s.TutorName</div>
                                            </div>
                                        </td>
                                        <td>@s.Subject</td>
                                        <td>@s.StartTime.ToString("d MMM yyyy")<br /><span class="muted">@s.StartTime.ToString("h:mm tt")</span></td>
                                        <td>@s.DurationLabel</td>
                                        <td>
                                            <span class="@StatusPillClass(s.DisplayStatus)">
                                                @if (s.DisplayStatus == "Live")
                                                {
                                                    <text>● Live</text>
                                                }
                                                else if (s.DisplayStatus == "Disputed")
                                                {
                                                    <text>⚠ Disputed</text>
                                                }
                                                else
                                                {
                                                    @s.DisplayStatus
                                                }
                                            </span>
                                        </td>
                                        <td>@s.Mode</td>
                                        <td>
                                            <div class="um-actions-cell">
                                                <button type="button" class="mini-btn sl-view-btn" data-booking-id="@s.BookingId">View</button>
                                                @if (s.IsDisputed)
                                                {
                                                    <form asp-controller="Admin" asp-action="ResolveDispute" method="post" style="margin:0;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="bookingId" value="@s.BookingId" />
                                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                        <button type="submit" class="mini-btn sl-review-btn">Resolve</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <form asp-controller="Admin" asp-action="FlagSessionDisputed" method="post" style="margin:0;" data-tb-confirm="Flag this session as disputed?" data-tb-confirm-label="Flag session" data-tb-confirm-danger="true">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="bookingId" value="@s.BookingId" />
                                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                        <button type="submit" class="mini-btn">Flag</button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="um-empty">No sessions match these filters.</p>
                    }

                    <div class="um-pagination-bar">
                        <span class="um-pagination-info">
                            @if (Model.TotalMatching == 0)
                            {
                                <text>No sessions found</text>
                            }
                            else
                            {
                                <text>Showing @rangeStart–@rangeEnd of @Model.TotalMatching.ToString("N0") sessions</text>
                            }
                        </span>

                        <div class="um-pagination">
                            <a class="um-page-btn @(Model.Page <= 1 ? "disabled" : "")" href="@PageUrl(Model.Page - 1)">‹</a>
                            @foreach (var p in Model.PageWindow)
                            {
                                if (p == null)
                                {
                                    <span class="um-page-ellipsis">…</span>
                                }
                                else
                                {
                                    <a class="um-page-btn @(p == Model.Page ? "active" : "")" href="@PageUrl(p.Value)">@p</a>
                                }
                            }
                            <a class="um-page-btn @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@PageUrl(Model.Page + 1)">›</a>
                        </div>

                        <select class="um-pagesize-select" onchange="slChangePageSize(this.value)">
                            <option value="8" selected="@(Model.PageSize == 8)">8 per page</option>
                            <option value="20" selected="@(Model.PageSize == 20)">20 per page</option>
                            <option value="50" selected="@(Model.PageSize == 50)">50 per page</option>
                            <option value="100" selected="@(Model.PageSize == 100)">100 per page</option>
                        </select>
                    </div>
                </div>

                <!-- Sessions over time chart -->
                <div class="panel chart-panel" style="margin-top:1rem;">
                    <div class="panel-head">
                        <h2>Sessions over time — last 14 days</h2>
                    </div>
                    @if (Model.ChartValues.Sum() == 0)
                    {
                        <div class="chart-empty">No sessions recorded in the last 14 days.</div>
                    }
                    else
                    {
                        <div class="chart-with-axis">
                            <div class="chart-axis-y">
                                <span>@Model.ChartMax</span>
                                <span>@((int)Math.Round(Model.ChartMax * 0.75))</span>
                                <span>@((int)Math.Round(Model.ChartMax * 0.5))</span>
                                <span>@((int)Math.Round(Model.ChartMax * 0.25))</span>
                                <span>0</span>
                            </div>
                            <div class="chart-plot">
                                <div class="bar-chart">
                                    @foreach (var value in Model.ChartValues)
                                    {
                                        var heightPct = Math.Max(2, (int)Math.Round(100.0 * value / Model.ChartMax));
                                        var isPeak = value == Model.ChartMax && value > 0;
                                        <div class="bar-col"><div class="bar @(isPeak ? "peak" : "")" style="height:@(heightPct)%"></div></div>
                                    }
                                </div>
                                <div class="bar-labels">
                                    @foreach (var label in Model.ChartLabels)
                                    {
                                        <span>@label</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </main>
        </div>
    </div>

    <div class="modal-overlay" id="sessionDetailsOverlay">
        <div class="modal-box">
            <div class="modal-head">
                <h3 id="sdTitle">Session details</h3>
                <button type="button" class="modal-close" id="sdCloseBtn">&times;</button>
            </div>
            <div id="sdBody" style="font-size:.9rem; line-height:1.6;">Loading...</div>
        </div>
    </div>

    <script>
            function slChangePageSize(value) {
                var url = new URL(window.location.href);
                url.searchParams.set('pageSize', value);
                url.searchParams.set('page', '1');
                window.location.href = url.toString();
            }

            var sdOverlay = document.getElementById('sessionDetailsOverlay');
            var sdBody = document.getElementById('sdBody');
            var sdTitle = document.getElementById('sdTitle');
            var sdCloseBtn = document.getElementById('sdCloseBtn');

            document.querySelectorAll('.sl-view-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = btn.getAttribute('data-booking-id');
                    sdTitle.textContent = 'Session details';
                    sdBody.innerHTML = 'Loading...';
                    sdOverlay.classList.add('open');

                    fetch('/Admin/SessionDetailsJson?id=' + id)
                        .then(function (r) { return r.json(); })
                        .then(function (d) {
                            sdTitle.textContent = 'Session #' + d.sessionId;
                            var html = ''
                                + '<p><strong>Status:</strong> ' + d.status + (d.isDisputed ? ' ⚠' : '') + '</p>'
                                + '<p><strong>Student:</strong> ' + d.studentName + ' (' + d.studentEmail + ')' + (d.studentDistrict ? ', ' + d.studentDistrict : '') + '</p>'
                                + '<p><strong>Tutor:</strong> ' + d.tutorName + ' (' + d.tutorEmail + ')' + (d.tutorDistrict ? ', ' + d.tutorDistrict : '') + '</p>'
                                + '<p><strong>Subject:</strong> ' + d.subject + '</p>'
                                + '<p><strong>Date & time:</strong> ' + d.date + ', ' + d.time + '</p>'
                                + '<p><strong>Mode:</strong> ' + (d.mode || '-') + '</p>'
                                + '<p><strong>Requested:</strong> ' + d.createdAt + '</p>'
                                + (d.decidedAt ? '<p><strong>Decided:</strong> ' + d.decidedAt + (d.declinedByTutor ? ' (declined by tutor)' : '') + '</p>' : '')
                                + (d.note ? '<p><strong>Student note:</strong> ' + d.note + '</p>' : '')
                                + '<p><strong>Calendar synced:</strong> ' + (d.calendarSynced ? 'Yes' : 'No') + '</p>';

                            if (d.isDisputed && d.ticketSubject) {
                                html += '<hr/><p><strong>⚠ Linked complaint</strong> (' + d.ticketStatus + ', filed ' + d.ticketFiledAt + ')</p>'
                                    + '<p><strong>' + d.ticketSubject + '</strong></p>'
                                    + '<p>' + d.ticketMessage + '</p>';
                            }

                            sdBody.innerHTML = html;
                        })
                        .catch(function () { sdBody.innerHTML = 'Could not load session details.'; });
                });
            });

            if (sdCloseBtn) sdCloseBtn.addEventListener('click', function () { sdOverlay.classList.remove('open'); });
            sdOverlay.addEventListener('click', function (e) { if (e.target === sdOverlay) sdOverlay.classList.remove('open'); });
    </script>
</body>
</html>