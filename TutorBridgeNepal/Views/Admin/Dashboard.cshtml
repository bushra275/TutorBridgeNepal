@model TutorBridgeNepal.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;

    string TrendBadgeClass(int? trend) => trend switch
    {
        null => "neutral",
        >= 0 => "up",
        _ => "urgent"
    };

    string TrendBadgeText(int? trend) => trend switch
    {
        null => "New",
        >= 0 => $"+{trend}%",
        _ => $"{trend}%"
    };

    string SessionStatusClass(string status) => status switch
    {
        "Completed" => "completed",
        "Cancelled" => "cancelled",
        "Missed" => "missed",
        "Confirmed" => "ongoing",
        _ => "pending"
    };

    string AvatarClass(int index) => (index % 3) switch
    {
        1 => "purple",
        2 => "yellow",
        _ => ""
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - TutorBridge Nepal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800;900&family=Playfair+Display:wght@@700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="dash-shell">

        <header class="dash-topbar">
            <a class="tb-brand" asp-controller="Home" asp-action="Index">TutorBridge <span>Nepal</span></a>
            <div class="dash-search">
                <input type="text" placeholder="Search users, sessions..." />
            </div>
            <span class="admin-chip">Admin</span>
            <div class="dash-topbar-right">
                <a href="#" class="icon-btn" title="Notifications">
                    🔔
                    @if (Model.OpenComplaintsCount > 0 || Model.PendingVerificationsCount > 0)
                    {
                        <span class="dot"></span>
                    }
                </a>
                <div class="topbar-avatar">@Model.AdminInitials</div>
            </div>
        </header>

        <div class="dash-body">
            <aside class="dash-sidebar">
                <div class="dash-user">
                    <div class="avatar">@Model.AdminInitials</div>
                    <div>
                        <div class="name">@Model.AdminName</div>
                        <div class="meta">Platform Administrator</div>
                        <span class="role-chip" style="background:#fff1d5;color:#a96808;">Super Admin</span>
                    </div>
                </div>

                <ul class="dash-nav">
                    <li><a asp-controller="Admin" asp-action="Dashboard" class="active"><span class="nav-icon">📊</span> Dashboard</a></li>
                    <li><a asp-controller="Admin" asp-action="UserManagement"><span class="nav-icon">👥</span> User Management</a></li>
                    <li>
                        <a asp-controller="Admin" asp-action="TutorVerification">
                            <span class="nav-icon">✅</span> Tutor Verification
                            @if (Model.PendingVerificationsCount > 0)
                            {
                                <span class="badge-count">@Model.PendingVerificationsCount</span>
                            }
                        </a>
                    </li>
                    <li><a asp-controller="Admin" asp-action="SessionLogs"><span class="nav-icon">🗒️</span> Session Logs</a></li>
                    <li><a asp-controller="Admin" asp-action="Reports"><span class="nav-icon">📈</span> Reports</a></li>                    <li>
                        <li>
                            <a asp-controller="Admin" asp-action="Complaints">
                                <span class="nav-icon">⚠️</span> Complaints
                                @if (Model.OpenComplaintsCount > 0)
                                {
                                    <span class="badge-count">@Model.OpenComplaintsCount</span>
                                }
                            </a>
                        </li>
                    </li>
                    <li><span class="disabled-nav-link" title="Coming soon"><span class="nav-icon">🔔</span> Notifications</span></li>
                </ul>

                <ul class="dash-nav-secondary">
                    <li><span class="disabled-nav-link" title="Coming soon"><span class="nav-icon">❓</span> Help center</span></li>
                    <li><a asp-controller="Account" asp-action="Logout"><span class="nav-icon">↩️</span> Log out</a></li>
                </ul>
            </aside>

            <main class="dash-main">
                <div class="dash-greeting" style="display:flex;align-items:flex-start;justify-content:space-between;">
                    <div>
                        <h1>Admin Dashboard</h1>
                        <p>@Model.TodayLabel · TutorBridge Nepal platform overview</p>
                    </div>
                    <span class="disabled-btn" title="Coming soon">Export report</span>
                </div>

                <!-- KPI row -->
                <div class="kpi-row">
                    <div class="kpi-card">
                        <div class="kpi-top">
                            <span class="label">Total users</span>
                            <span class="kpi-badge @TrendBadgeClass(Model.TotalUsersTrendPercent)">@TrendBadgeText(Model.TotalUsersTrendPercent)</span>
                        </div>
                        <div class="kpi-value">@Model.TotalUsers.ToString("N0")</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-top">
                            <span class="label">Active tutors</span>
                            <span class="kpi-badge @TrendBadgeClass(Model.ActiveTutorsTrendPercent)">@TrendBadgeText(Model.ActiveTutorsTrendPercent)</span>
                        </div>
                        <div class="kpi-value">@Model.ActiveTutors.ToString("N0")</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-top">
                            <span class="label">Sessions this month</span>
                            <span class="kpi-badge @TrendBadgeClass(Model.SessionsTrendPercent)">@TrendBadgeText(Model.SessionsTrendPercent)</span>
                        </div>
                        <div class="kpi-value">@Model.SessionsThisMonth.ToString("N0")</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-top">
                            <span class="label">Pending verifications</span>
                            @if (Model.PendingVerificationsCount > 0)
                            {
                                <span class="kpi-badge urgent">Urgent</span>
                            }
                            else
                            {
                                <span class="kpi-badge up">Clear</span>
                            }
                        </div>
                        <div class="kpi-value">@Model.PendingVerificationsCount</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-top">
                            <span class="label">Open complaints</span>
                            @if (Model.OpenComplaintsCount > 0)
                            {
                                <span class="kpi-badge review">Review</span>
                            }
                            else
                            {
                                <span class="kpi-badge up">Clear</span>
                            }
                        </div>
                        <div class="kpi-value">@Model.OpenComplaintsCount</div>
                    </div>
                </div>

                <div class="dash-columns">
                    <!-- Left -->
                    <div>
                        <div class="panel chart-panel">
                            <div class="panel-head">
                                <h2>Session activity — @Model.ChartMonthLabel</h2>
                                <button class="btn-period" type="button">This month</button>
                            </div>
                            @if (Model.ChartValues.Sum() == 0)
                            {
                                <div class="chart-empty">No sessions recorded yet this month.</div>
                            }
                            else
                            {
                                <div class="chart-with-axis">
                                    <div class="chart-axis-y">
                                        <span>@Model.ChartMax</span>
                                        <span>@((int)Math.Round(Model.ChartMax * 0.75))</span>
                                        <span>@((int)Math.Round(Model.ChartMax * 0.5))</span>
                                        <span>@((int)Math.Round(Model.ChartMax * 0.25))</span>
                                        <span>0</span>
                                    </div>
                                    <div class="chart-plot">
                                        <div class="bar-chart">
                                            @foreach (var value in Model.ChartValues)
                                            {
                                                var heightPct = Math.Max(2, (int)Math.Round(100.0 * value / Model.ChartMax));
                                                var isPeak = value == Model.ChartMax && value > 0;
                                                <div class="bar-col"><div class="bar @(isPeak ? "peak" : "")" style="height:@(heightPct)%"></div></div>
                                            }
                                        </div>
                                        <div class="bar-labels">
                                            @foreach (var label in Model.ChartLabels)
                                            {
                                                <span>@label</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="panel">
                            <div class="panel-head"><h2>Recent sessions</h2></div>
                            @if (Model.RecentSessions.Any())
                            {
                                <table class="dash-table">
                                    <thead>
                                        <tr>
                                            <th>Student</th>
                                            <th>Tutor</th>
                                            <th>Subject</th>
                                            <th>Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var s in Model.RecentSessions)
                                        {
                                            <tr>
                                                <td>@s.StudentName</td>
                                                <td>@s.TutorName</td>
                                                <td>@s.Subject</td>
                                                <td>@s.Date.ToString("d MMM")</td>
                                                <td><span class="status-text @SessionStatusClass(s.Status)">@s.Status</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="empty-row">No sessions recorded yet.</p>
                            }
                            <a href="#" class="view-all-link">View all sessions →</a>
                        </div>

                        <div class="panel">
                            <div class="panel-head">
                                <h2>Open complaints</h2>
                                <span class="tag-count" style="background:var(--danger-bg);color:var(--danger);">@Model.OpenComplaintsCount</span>
                            </div>
                            @if (Model.OpenComplaints.Any())
                            {
                                @for (var i = 0; i < Model.OpenComplaints.Count; i++)
                                {
                                    var c = Model.OpenComplaints[i];
                                    <div class="complaint-card @(i % 2 == 1 ? "warning" : "")">
                                        <div class="complaint-info">
                                            <div class="title">@c.Subject</div>
                                            <div class="meta">Reported by @c.ReporterName (@c.ReporterRole) · @c.CreatedAt.ToString("d MMM yyyy")</div>
                                        </div>
                                        <a asp-controller="Admin" asp-action="Dashboard" class="mini-btn">Review</a>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="empty-row">No open complaints right now.</p>
                            }
                        </div>
                    </div>

                    <!-- Right -->
                    <div>
                        <div class="panel">
                            <div class="panel-head">
                                <h2>Tutor verification queue</h2>
                                <span class="tag-count">@Model.PendingVerificationsCount</span>
                            </div>
                            @if (Model.PendingVerifications.Any())
                            {
                                @for (var i = 0; i < Model.PendingVerifications.Count; i++)
                                {
                                    var v = Model.PendingVerifications[i];
                                    <div class="queue-row">
                                        <div class="avatar @AvatarClass(i)">@v.Initials</div>
                                        <div class="queue-info">
                                            <div class="name">@v.Name</div>
                                            <div class="meta">@(v.FirstSubject ?? "General") · @(v.District ?? "Nepal")</div>
                                        </div>
                                        <div class="queue-actions">
                                            <form asp-controller="Admin" asp-action="ApproveTutor" method="post" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="tutorProfileId" value="@v.TutorProfileId" />
                                                <button type="submit" class="mini-btn green">Approve</button>
                                            </form>
                                            <form asp-controller="Admin" asp-action="RejectTutor" method="post" style="margin:0;" onsubmit="return confirm('Reject this tutor application?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="tutorProfileId" value="@v.TutorProfileId" />
                                                <button type="submit" class="mini-btn danger">Reject</button>
                                            </form>
                                        </div>
                                    </div>
                                }
                                <a asp-controller="Admin" asp-action="TutorVerification" class="view-all-link">View all @Model.PendingVerificationsCount pending →</a>
                            }
                            else
                            {
                                <p class="empty-row">No tutors waiting on verification.</p>
                            }
                        </div>

                        <div class="panel">
                            <div class="panel-head"><h2>Recent registrations</h2></div>
                            @if (Model.RecentRegistrations.Any())
                            {
                                <table class="dash-table">
                                    <thead>
                                        <tr><th>Name</th><th>Role</th><th>District</th><th>Status</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var u in Model.RecentRegistrations)
                                        {
                                            <tr>
                                                <td>@u.Name</td>
                                                <td>@u.Role</td>
                                                <td>@(u.District ?? "—")</td>
                                                <td>
                                                    @if (u.StatusLabel == "Active")
                                                    {
                                                        <span class="pill pill-active">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="pill pill-pending2">Pending</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="empty-row">No registrations yet.</p>
                            }
                            <a href="#" class="view-all-link">View all users →</a>
                        </div>

                        <div class="panel">
                            <div class="panel-head"><h2>Platform health</h2></div>
                            <div class="progress-row">
                                <div class="progress-label"><span>Tutor approval rate</span><span>@Model.TutorApprovalRatePercent%</span></div>
                                <div class="progress-track"><div class="progress-fill" style="width:@(Model.TutorApprovalRatePercent)%"></div></div>
                            </div>
                            <div class="progress-row">
                                <div class="progress-label"><span>Session completion rate</span><span>@Model.SessionCompletionRatePercent%</span></div>
                                <div class="progress-track"><div class="progress-fill" style="width:@(Model.SessionCompletionRatePercent)%"></div></div>
                            </div>
                            <div class="progress-row">
                                <div class="progress-label"><span>Student satisfaction</span><span>@Model.StudentSatisfactionPercent%</span></div>
                                <div class="progress-track"><div class="progress-fill" style="width:@(Model.StudentSatisfactionPercent)%"></div></div>
                            </div>
                            <div class="progress-row">
                                <div class="progress-label"><span>Complaint resolution rate</span><span>@Model.ComplaintResolutionRatePercent%</span></div>
                                <div class="progress-track"><div class="progress-fill orange" style="width:@(Model.ComplaintResolutionRatePercent)%"></div></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-head">
                        <h2>Recent activity log</h2>
                        <span class="mini-btn panel-action" style="opacity:.6;cursor:not-allowed;" title="Coming soon">View all</span>
                    </div>
                    @if (Model.RecentActivity.Any())
                    {
                        @foreach (var a in Model.RecentActivity)
                        {
                            <div class="activity-item">
                                <div class="activity-dot @a.DotClass"></div>
                                <div class="activity-time">@a.Timestamp.ToString("h:mm tt")</div>
                                <div class="activity-text"><strong>@a.BoldLead</strong> — @a.RestText</div>
                                <span class="activity-tag @a.TagClass">@a.Tag</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="empty-row">No recent activity yet.</p>
                    }
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
