@model TutorBridgeNepal.ViewModels.AdminTutorVerificationViewModel
@{
    ViewData["Title"] = "Tutor Verification";
    Layout = null;

    string TabUrl(string tab) => Url.Action("TutorVerification", new
    {
        tab,
        search = Model.Search,
        subject = Model.SubjectFilter,
        district = Model.DistrictFilter,
        submitted = Model.SubmittedFilter,
        sort = Model.Sort,
        visibleCount = 3
    })!;

    string TrendBadgeClass(int? trend) => trend switch { null => "neutral", >= 0 => "up", _ => "urgent" };
    string TrendBadgeText(int? trend) => trend switch { null => "New", >= 0 => $"+{trend}%", _ => $"{trend}%" };

    string DaysAgoText(int days) => days switch
    {
        0 => "Submitted today",
        1 => "Submitted 1d ago",
        _ => $"Submitted {days}d ago"
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tutor Verification - TutorBridge Nepal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="dash-shell">

        <header class="dash-topbar">
            <a class="tb-brand" asp-controller="Home" asp-action="Index">TutorBridge <span>Nepal</span></a>
            <div class="dash-search">
                <input type="text" placeholder="Search users, sessions..." />
            </div>
            <span class="admin-chip">Admin</span>
            <div class="dash-topbar-right">
                @await Html.PartialAsync("_AdminNotifBell")
                @await Html.PartialAsync("_AdminProfileDropdown")
            </div>
        </header>

        <div class="dash-body">
            <aside class="dash-sidebar">
                <div class="dash-user">
                    @if (!string.IsNullOrEmpty(ViewData["AdminProfilePhotoUrl"] as string))
                    {
                        <div class="avatar" style="padding:0; overflow:hidden;"><img src="@(ViewData["AdminProfilePhotoUrl"] as string)" alt="@Model.AdminName" style="width:100%; height:100%; object-fit:cover; border-radius:50%;" /></div>
                    }
                    else
                    {
                        <div class="avatar">@Model.AdminInitials</div>
                    }
                    <div>
                        <div class="name">@Model.AdminName</div>
                        <div class="meta">Platform Administrator</div>
                        <span class="role-chip" style="background:#fff1d5;color:#a96808;">Super Admin</span>
                    </div>
                </div>

                <ul class="dash-nav">
                    <li><a asp-controller="Admin" asp-action="Dashboard"><span class="nav-icon">📊</span> Dashboard</a></li>
                    <li><a asp-controller="Admin" asp-action="UserManagement"><span class="nav-icon">👥</span> User Management</a></li>
                    <li>
                        <a asp-controller="Admin" asp-action="TutorVerification" class="active">
                            <span class="nav-icon">✅</span> Tutor Verification
                            @if ((int)(ViewData["SidebarPendingVerificationsCount"] ?? 0) > 0)
                            {
                                <span class="badge-count">@ViewData["SidebarPendingVerificationsCount"]</span>
                            }
                        </a>
                    </li>
                    <li><a asp-controller="Admin" asp-action="SessionLogs"><span class="nav-icon">🗒️</span> Session Logs</a></li>
                    <li><a asp-controller="Admin" asp-action="Reports"><span class="nav-icon">📈</span> Reports</a></li>
                    <li>
                        <a asp-controller="Admin" asp-action="Complaints">
                            <span class="nav-icon">⚠️</span> Complaints
                            @if ((int)(ViewData["SidebarOpenComplaintsCount"] ?? 0) > 0)
                            {
                                <span class="badge-count">@ViewData["SidebarOpenComplaintsCount"]</span>
                            }
                        </a>
                    </li>
                    <li><a asp-controller="Admin" asp-action="Notifications"><span class="nav-icon">🔔</span> Notifications</a></li>
                    <li><a asp-controller="Admin" asp-action="Settings"><span class="nav-icon">⚙️</span> Settings</a></li>
                </ul>

                <ul class="dash-nav-secondary">
                    <li><a asp-controller="Account" asp-action="Logout"><span class="nav-icon">↩️</span> Log out</a></li>
                </ul>
            </aside>

            <main class="dash-main">
                <div class="dash-greeting" style="display:flex;align-items:flex-start;justify-content:space-between;">
                    <div>
                        <h1>Tutor Verification</h1>
                        <p>Review submitted credentials and approve or reject new tutor applications</p>
                    </div>
                    <div class="um-header-actions">
                        <a class="um-btn-outline" asp-action="ExportTutorVerificationCsv" asp-route-tab="@Model.ActiveTab" asp-route-search="@Model.Search" asp-route-subject="@Model.SubjectFilter" asp-route-district="@Model.DistrictFilter" asp-route-submitted="@Model.SubmittedFilter">Export list</a>
                    </div>
                </div>

                @if (TempData["SettingsSuccess"] != null)
                {
                    <div class="status-banner success mb-3">@TempData["SettingsSuccess"]</div>
                }
                @if (TempData["SettingsError"] != null)
                {
                    <div class="status-banner error mb-3">@TempData["SettingsError"]</div>
                }

                <!-- KPI strip -->
                <div class="kpi-row">
                    <div class="kpi-card">
                        <div class="kpi-top">
                            <span class="label">Pending review</span>
                            @if (Model.PendingCount > 0)
                            {
                                <span class="kpi-badge urgent">Urgent</span>
                            }
                        </div>
                        <div class="kpi-value">@Model.PendingCount</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-top">
                            <span class="label">Approved (@Model.MonthLabel)</span>
                            <span class="kpi-badge @TrendBadgeClass(Model.ApprovedTrendPercent)">@TrendBadgeText(Model.ApprovedTrendPercent)</span>
                        </div>
                        <div class="kpi-value">@Model.ApprovedThisMonth</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-top">
                            <span class="label">Rejected (@Model.MonthLabel)</span>
                            <span class="kpi-badge neutral">@(Model.RejectedRatePercent.HasValue ? $"{Model.RejectedRatePercent}% rate" : "—")</span>
                        </div>
                        <div class="kpi-value">@Model.RejectedThisMonth</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-top"><span class="label">Avg review time</span></div>
                        <div class="kpi-value">@(Model.AvgReviewTimeDays.HasValue ? $"{Model.AvgReviewTimeDays} days" : "—")</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-top"><span class="label">Approval rate</span></div>
                        <div class="kpi-value" style="color:var(--green);">@Model.ApprovalRatePercent%</div>
                    </div>
                </div>

                <!-- Tabs -->
                <div class="um-tabs">
                    <a class="um-tab @(Model.ActiveTab == "pending" ? "active" : "")" href="@TabUrl("pending")">Pending (@Model.PendingTabCount)</a>
                    <a class="um-tab @(Model.ActiveTab == "approved" ? "active" : "")" href="@TabUrl("approved")">Approved</a>
                    <a class="um-tab @(Model.ActiveTab == "rejected" ? "active" : "")" href="@TabUrl("rejected")">Rejected</a>
                    <a class="um-tab @(Model.ActiveTab == "all" ? "active" : "")" href="@TabUrl("all")">All applications</a>
                </div>

                <!-- Filters -->
                <form method="get" asp-action="TutorVerification" id="filterForm">
                    <input type="hidden" name="tab" value="@Model.ActiveTab" />
                    <div class="um-toolbar">
                        <div class="um-search">
                            <input type="text" name="search" value="@Model.Search" placeholder="Search by name or subject..." />
                        </div>
                        <select class="um-select" name="subject" onchange="this.form.submit()">
                            <option value="">Subject</option>
                            @foreach (var s in Model.Subjects)
                            {
                                <option value="@s" selected="@(Model.SubjectFilter == s)">@s</option>
                            }
                        </select>
                        <select class="um-select" name="district" onchange="this.form.submit()">
                            <option value="">District</option>
                            @foreach (var d in Model.Districts)
                            {
                                <option value="@d" selected="@(Model.DistrictFilter == d)">@d</option>
                            }
                        </select>
                        <select class="um-select" name="submitted" onchange="this.form.submit()">
                            <option value="all" selected="@(Model.SubmittedFilter == "all")">Submitted date</option>
                            <option value="last7" selected="@(Model.SubmittedFilter == "last7")">Last 7 days</option>
                            <option value="last30" selected="@(Model.SubmittedFilter == "last30")">Last 30 days</option>
                            <option value="last90" selected="@(Model.SubmittedFilter == "last90")">Last 90 days</option>
                        </select>
                        <select class="um-select um-select-sort" name="sort" onchange="this.form.submit()">
                            <option value="newest" selected="@(Model.Sort == "newest")">Sort: Newest first</option>
                            <option value="oldest" selected="@(Model.Sort == "oldest")">Sort: Oldest first</option>
                            <option value="name_asc" selected="@(Model.Sort == "name_asc")">Sort: Name (A-Z)</option>
                            <option value="name_desc" selected="@(Model.Sort == "name_desc")">Sort: Name (Z-A)</option>
                        </select>
                    </div>
                </form>

                <!-- Application cards -->
                <div class="tv-list">
                    @if (Model.Applications.Any())
                    {
                        @foreach (var a in Model.Applications)
                        {
                            <div class="tv-card tv-border-@a.UrgencyClass">
                                <div class="avatar tv-avatar">@a.Initials</div>
                                <div class="tv-body">
                                    <div class="tv-head">
                                        <span class="tv-name">@a.Name</span>
                                        <span class="tv-submitted">🕒 @DaysAgoText(a.DaysAgo)</span>
                                    </div>
                                    <div class="tv-contact">
                                        @a.Email
                                        @if (!string.IsNullOrEmpty(a.MaskedPhone))
                                        {
                                            <text>· @a.MaskedPhone</text>
                                        }
                                    </div>
                                    <div class="tv-applying">
                                        @(a.District ?? "District not set") · Applying for: @(a.Subjects.Any() ? string.Join(", ", a.Subjects) : "—")
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(a.Education))
                                    {
                                        <div class="tv-line">Education: @a.Education</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(a.ExperienceSummary))
                                    {
                                        <div class="tv-line">Experience: @a.ExperienceSummary</div>
                                    }
                                    <a asp-action="UserDetail" asp-route-userId="@a.UserId" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="tv-view-link">View full profile</a>
                                </div>
                                <div class="tv-docs" style="@(a.Status == "Pending" && a.AllDocumentsUploaded ? "flex:0 0 640px;" : "")">
                                    <div style="display:flex; gap:1.5rem; flex-wrap:wrap; align-items:flex-start; margin-bottom: @(a.Status == "Pending" && a.AllDocumentsUploaded ? "0" : "1rem");">
                                        <div style="min-width:220px;">
                                            <div class="tv-docs-label">SUBMITTED DOCUMENTS</div>
                                            <div class="tv-docs-grid" style="margin-bottom:0;">
                                                @foreach (var doc in a.Documents)
                                                {
                                                    if (doc.IsMissing)
                                                    {
                                                        <span class="tv-doc-chip tv-doc-missing" title="Not uploaded">⚠️ @doc.Label missing</span>
                                                    }
                                                    else
                                                    {
                                                        <a class="tv-doc-chip" asp-action="DownloadVerificationDocument" asp-route-credentialId="@doc.CredentialId" target="_blank">@doc.Icon @doc.Label</a>
                                                    }
                                                }
                                            </div>
                                        </div>

                                        @if (a.Status == "Pending" && a.AllDocumentsUploaded && !a.InterviewScheduledAt.HasValue)
                                        {
                                            <div style="flex:1; min-width:280px;">
                                                <div class="tv-note-sent" style="margin-bottom:.6rem;">📄 All documents received - schedule an interview to proceed.</div>
                                                <form asp-controller="Admin" asp-action="ScheduleTutorInterview" method="post" style="display:flex; gap:.5rem; flex-wrap:wrap; align-items:flex-end; margin:0;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="tutorProfileId" value="@a.TutorProfileId" />
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <div>
                                                        <label style="font-size:.75rem; font-weight:700; display:block;">Interview date &amp; time</label>
                                                        <input type="datetime-local" name="interviewAt" required class="tb-input" />
                                                    </div>
                                                    <div style="flex:1; min-width:200px;">
                                                        <label style="font-size:.75rem; font-weight:700; display:block;">Meeting link</label>
                                                        <input type="url" name="meetingLink" required placeholder="https://meet.google.com/..." class="tb-input" />
                                                    </div>
                                                    <button type="submit" class="mini-btn green">📅 Schedule interview</button>
                                                </form>
                                            </div>
                                        }
                                        @if (a.Status == "Pending" && a.InterviewScheduledAt.HasValue && !a.InterviewHasHappened)
                                        {
                                            <div style="flex:1; min-width:280px;">
                                                <div class="tv-note-sent" style="margin-bottom:.6rem;">
                                                    📅 Interview scheduled for @a.InterviewScheduledAt.Value.ToString("d MMM yyyy, h:mm tt")
                                                    @if (!string.IsNullOrWhiteSpace(a.InterviewMeetingLink))
                                                    {
                                                        <text> — <a href="@a.InterviewMeetingLink" target="_blank">meeting link</a></text>
                                                    }
                                                    . Approve/Reject unlock once this time has passed.
                                                </div>

                                                <button type="button" class="mini-btn" data-note-toggle="tv-reschedule-@a.TutorProfileId">Reschedule</button>
                                                <form asp-controller="Admin" asp-action="ScheduleTutorInterview" method="post" class="tv-note-form" id="tv-reschedule-@a.TutorProfileId" style="display:flex; gap:.5rem; flex-wrap:wrap; align-items:flex-end;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="tutorProfileId" value="@a.TutorProfileId" />
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <div>
                                                        <label style="font-size:.75rem; font-weight:700; display:block;">New date &amp; time</label>
                                                        <input type="datetime-local" name="interviewAt" required class="tb-input" />
                                                    </div>
                                                    <div style="flex:1; min-width:200px;">
                                                        <label style="font-size:.75rem; font-weight:700; display:block;">Meeting link</label>
                                                        <input type="url" name="meetingLink" required value="@a.InterviewMeetingLink" class="tb-input" />
                                                    </div>
                                                    <button type="submit" class="mini-btn green">Update</button>
                                                </form>
                                            </div>
                                        }
                                    </div>

                                    @if (a.Status == "Pending" && !a.AllDocumentsUploaded)
                                    {
                                        <div class="tv-actions">
                                            <button type="button" class="mini-btn" data-note-toggle="tv-note-@a.TutorProfileId">Request more info</button>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(a.VerificationNote))
                                        {
                                            <div class="tv-note-sent">📝 Sent: "@a.VerificationNote"</div>
                                        }

                                        <form asp-controller="Admin" asp-action="RequestMoreInfoTutor" method="post" class="tv-note-form" id="tv-note-@a.TutorProfileId">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tutorProfileId" value="@a.TutorProfileId" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                            <textarea name="note" maxlength="500" required placeholder="What's missing or needs fixing? e.g. Police report is blurry, please re-upload.">@a.VerificationNote</textarea>
                                            <button type="submit" class="mini-btn green">Send to tutor</button>
                                        </form>
                                    }
                                    else if (a.Status == "Pending" && a.AllDocumentsUploaded && !a.InterviewScheduledAt.HasValue)
                                    {
                                        @* <!-- Nothing to show here - the "schedule an interview" form already
                                             rendered above, next to the document chips. --> *@ 
                                    }
                                    else if (a.Status == "Pending" && a.InterviewScheduledAt.HasValue && !a.InterviewHasHappened)
                                    {
                                        <!-- Nothing to show here - the scheduled-interview info and
                                             reschedule form already rendered above, next to the document chips. -->
                                    }
                                    else if (a.Status == "Pending")
                                    {
                                        <div class="tv-actions">
                                            <form asp-controller="Admin" asp-action="ApproveTutor" method="post" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="tutorProfileId" value="@a.TutorProfileId" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                <button type="submit" class="mini-btn green">✓ Approve</button>
                                            </form>
                                            <button type="button" class="mini-btn danger" data-note-toggle="tv-reject-@a.TutorProfileId">✕ Reject</button>
                                            <button type="button" class="mini-btn" data-note-toggle="tv-note-@a.TutorProfileId">Request more info</button>
                                        </div>

                                        <form asp-controller="Admin" asp-action="RejectTutor" method="post" class="tv-note-form" id="tv-reject-@a.TutorProfileId">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tutorProfileId" value="@a.TutorProfileId" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                            <textarea name="reason" maxlength="500" required placeholder="Why is this application being rejected? e.g. Citizenship document is unreadable, please re-upload a clearer scan."></textarea>
                                            <button type="submit" class="mini-btn danger">Confirm reject</button>
                                        </form>

                                        @if (!string.IsNullOrWhiteSpace(a.VerificationNote))
                                        {
                                            <div class="tv-note-sent">📝 Sent: "@a.VerificationNote"</div>
                                        }

                                        <form asp-controller="Admin" asp-action="RequestMoreInfoTutor" method="post" class="tv-note-form" id="tv-note-@a.TutorProfileId">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tutorProfileId" value="@a.TutorProfileId" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                            <textarea name="note" maxlength="500" required placeholder="What's missing or needs fixing? e.g. Police report is blurry, please re-upload.">@a.VerificationNote</textarea>
                                            <button type="submit" class="mini-btn green">Send to tutor</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <div class="tv-actions">
                                            <span class="pill @(a.Status == "Approved" ? "pill-active" : "pill-suspended")">@a.Status</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (Model.HasMore)
                        {
                            <a class="view-all-link tv-more-link" href="@Url.Action("TutorVerification", new
                               {
                                   tab = Model.ActiveTab,
                                   search = Model.Search,
                                   subject = Model.SubjectFilter,
                                   district = Model.DistrictFilter,
                                   submitted = Model.SubmittedFilter,
                                   sort = Model.Sort,
                                   visibleCount = Model.VisibleCount + 10
                               })">
                                View @Model.RemainingCount more @(Model.ActiveTab) application@(Model.RemainingCount == 1 ? "" : "s") →
                            </a>
                        }
                    }
                    else
                    {
                        <p class="empty-row">No applications match these filters.</p>
                    }
                </div>
            </main>
        </div>
    </div>

    <script>
            document.querySelectorAll('[data-note-toggle]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var form = document.getElementById(btn.dataset.noteToggle);
                    if (form) form.classList.toggle('open');
                });
            });
    </script>
</body>
</html>